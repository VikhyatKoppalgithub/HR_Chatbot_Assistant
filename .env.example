# Copy this file to `.env` and fill in your key.
#   cp .env.example .env
#
# `.env` is gitignored. Never commit a real key.

# Required only for `python cli.py ask` (the generation step).
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# --- Optional overrides ---------------------------------------------------

# The model that writes the answers.
# Note: the code sends `thinking: {"type": "adaptive"}`, which current models
# (Opus 5, Sonnet 5, Opus 4.8) support. Older models use a different parameter
# and will return a 400 if you point this at them.
# ANTHROPIC_MODEL=claude-opus-5

# How hard the model works: low | medium | high | xhigh | max
# Grounded lookup doesn't need much. Raise it if you add questions that
# require combining several policies.
# EFFORT=medium

# Caps thinking AND the visible answer together -- leave headroom.
# MAX_TOKENS=4000

# Any sentence-transformers model works. Bigger = better and slower.
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Optional. HuggingFace prints "you are sending unauthenticated requests to the
# HF Hub" on startup -- it is checking whether a newer copy of the embedding
# model exists. Harmless, and it does NOT rate-limit normal use.
#
# Once the model is cached (after your first `ingest`), turning offline mode on
# skips that network call entirely: no warning, and a slightly faster start.
# Leave it off until the model has downloaded once, or loading will fail.
# HF_HUB_OFFLINE=1
